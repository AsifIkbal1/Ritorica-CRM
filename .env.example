# ===== SIM Balance Monitoring (Backend-only credentials) =====
# Copy this file to .env for local use, or add these keys to Vercel Project Environment Variables.
# Never commit .env with real secrets!

# Infozillion MNPSP master API key (from https://myportal.mnpspbd.com -> API)
# MNPSP_API_KEY=your_mnpsp_api_key
# MNPSP_BASE_URL=https://api.mnpspbd.com

# Supported per-SIM types: mnpsp-ans | mnpsp | gp-cmp | ritorica-v2 | ritorica-v1 | generic-json
# Note: For mnpsp-ans, mno code (GP, RB, TT, BL) is auto-detected from the SIM prefix.

# 1. Teletalk (01552146408) via Infozillion MNPSP Check ANS Balance
# SIM_BALANCE_01552146408_TYPE=mnpsp-ans
# SIM_BALANCE_01552146408_USERNAME=your_teletalk_username
# SIM_BALANCE_01552146408_PASSWORD=your_teletalk_api_password

# 2. Grameenphone (01339911694) via Infozillion MNPSP Check ANS Balance (or gp-cmp)
# SIM_BALANCE_01339911694_TYPE=mnpsp-ans
# SIM_BALANCE_01339911694_USERNAME=your_gp_username
# SIM_BALANCE_01339911694_PASSWORD=your_gp_api_password
# SIM_BALANCE_01339911694_SCALE=100
# SIM_BALANCE_01339911694_UNIT=paisa

# 3. Banglalink (01969904987) via Infozillion MNPSP Check ANS Balance
# SIM_BALANCE_01969904987_TYPE=mnpsp-ans
# SIM_BALANCE_01969904987_USERNAME=your_bl_username
# SIM_BALANCE_01969904987_PASSWORD=your_bl_api_password

# 4. Banglalink (01969904986) via Infozillion MNPSP Check ANS Balance
# SIM_BALANCE_01969904986_TYPE=mnpsp-ans
# SIM_BALANCE_01969904986_USERNAME=your_bl_username_2
# SIM_BALANCE_01969904986_PASSWORD=your_bl_api_password_2

# 5. Robi (01805991952) via Infozillion MNPSP Check ANS Balance
# SIM_BALANCE_01805991952_TYPE=mnpsp-ans
# SIM_BALANCE_01805991952_USERNAME=your_robi_username_2
# SIM_BALANCE_01805991952_PASSWORD=your_robi_api_password_2

# 6. Robi (01805991951) via Infozillion MNPSP Check ANS Balance
# SIM_BALANCE_01805991951_TYPE=mnpsp-ans
# SIM_BALANCE_01805991951_USERNAME=your_robi_username
# SIM_BALANCE_01805991951_PASSWORD=your_robi_api_password
# Optional unit/multiplier if operator returns SMS credits instead of BDT:
# SIM_BALANCE_01805991951_UNIT=sms
# SIM_BALANCE_01805991951_MULTIPLIER=0.2542407355
